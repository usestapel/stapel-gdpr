{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gdpr.erasure.requested",
  "description": "An erasure was opened for one subject. Every data owner that claims this subject_type must erase its slice and confirm with gdpr.section.erased carrying the same correlation_id. Supersedes user.deleted, which fires alongside for account subjects until 0.6.0.",
  "type": "object",
  "required": ["request_id", "correlation_id", "subject_type", "subject_key"],
  "properties": {
    "request_id":     { "type": "integer" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "subject_type":   { "type": "string", "examples": ["account", "workspace", "meeting", "recording", "document", "file"] },
    "subject_key":    { "type": "string" },
    "workspace_id":   { "type": "string" },
    "requested_by":   { "type": "string" },
    "origin":         { "type": "string", "enum": ["user", "dsar", "inactivity", "restore_requeue", "admin"] },
    "due_at":         { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
